{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @deejaytools/schemas build && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @deejaytools/schemas build && tsc --noEmit",
