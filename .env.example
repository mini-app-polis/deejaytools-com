# deejaytools-com — the names this repository reads. Names only: the values
# live in Doppler, the Cloudflare Pages project, or CI (site.yml); a local
# run reads them from the environment or a local .env. Uncommented names are
# required for a build; commented ones are optional or only for the suites
# below. How a build gets them: docs/DEPLOYMENT.md.

# ─────────────────────────────────────────────────────────────────────
# The app (build time)
# ─────────────────────────────────────────────────────────────────────
# vite.config.ts maps these into the bundle by name, so every one ends up
# in public JavaScript: none is a secret.

# API base URL. Production-branch builds read DEEJAYTOOLS_API; every other
# build, and a local run, reads DEEJAYTOOLS_API_DEV. Unset locally, the app
# calls http://localhost:3001 through the dev-server proxy.
# DEEJAYTOOLS_API=
# DEEJAYTOOLS_API_DEV=

# The Clerk publishable key.
DEEJAYTOOLS_CLERK_PUBLISHABLE_KEY=

# Browser Sentry (a Browser/React project under deejaytools-com). Unset,
# nothing is sent.
# SENTRY_DSN_DEEJAYTOOLS=

# Only the literal "1" replaces the app with a maintenance page. Build-time:
# set it in Cloudflare Pages, then redeploy.
# VITE_MAINTENANCE=

# Set by Cloudflare Pages on every build: the branch (main is a production
# build) and the commit the nav shows on non-production hosts. Locally the
# branch is unset and the commit comes from git.
# CF_PAGES_BRANCH=
# CF_PAGES_COMMIT_SHA=

# ─────────────────────────────────────────────────────────────────────
# Live contract suite (src/contract)
# ─────────────────────────────────────────────────────────────────────
# Runs only with a development Clerk key, never against production: the dev
# API to call, the development instance's secret key (sk_test_…), and the
# test user.
# CONTRACT_API_URL=
# CONTRACT_CLERK_SECRET_KEY=
# CONTRACT_USER_ID=

# ─────────────────────────────────────────────────────────────────────
# End-to-end suite (e2e/, playwright.config.ts)
# ─────────────────────────────────────────────────────────────────────
# Writes data, so the same guards (e2e/env.ts): the deployed dev site to
# test, that site's Clerk key (pk_test_…) and the development instance's
# secret key (sk_test_…), plus CONTRACT_API_URL and CONTRACT_USER_ID above.
# A11Y_REPORT_ONLY=1 reports accessibility violations without failing. CI
# is set by GitHub Actions: one retry, and the GitHub reporter.
# E2E_BASE_URL=
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# A11Y_REPORT_ONLY=
# CI=
