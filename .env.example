VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Sentry — optional. When set, browser errors (uncaught, recoverable, and
# explicit captures from logger.error) are sent to Sentry. Get DSN from
# sentry.io — create a Browser/React project under deejaytools-com.
SENTRY_DSN_DEEJAYTOOLS=

# Maintenance mode — only the literal "1" replaces the app with a maintenance
# page. Build-time: set in Cloudflare Pages, then redeploy.
# VITE_MAINTENANCE=1
